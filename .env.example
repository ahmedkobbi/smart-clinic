# Smart Clinic — Environment Variables
# Copy this file to `.env` and adjust values for your environment.

# Database URL — SQLite for local dev, PostgreSQL for production
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/smartclinic?schema=public"

# NextAuth (when enabling authentication)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="your-secret-key-here"

# Optional: AI provider (Anthropic) for ambient scribe
# ANTHROPIC_API_KEY=""

# Optional: Object storage (MinIO/S3) for documents & imaging
# S3_ENDPOINT=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET="smartclinic-documents"

# Optional: OpenFGA for ReBAC authorization
# FGA_API_URL="http://localhost:8080"
# FGA_STORE_ID=""

# Optional: OpenBao/Vault for envelope encryption
# OPENBAO_ADDR="http://localhost:8200"
# OPENBAO_TOKEN=""
